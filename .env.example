# ─── ARTIC VMS — Environment Variables Reference ─────────────────────────────
# Copy the relevant section to .env and fill in real values.
# NEVER commit a file containing real secrets — only this .env.example goes to git.

# =============================================================================
# OPTION A — Self-hosted on VPS (Contabo / Hetzner / DigitalOcean)
#   docker compose reads these from the root .env file
# =============================================================================

# ── Database (Docker Postgres) ────────────────────────────────────────────────
POSTGRES_PASSWORD=change_this_to_a_strong_password

# ── Backend env (also set in backend/.env) ───────────────────────────────────
DATABASE_URL=postgresql://artic_user:POSTGRES_PASSWORD@postgres:5432/fleet_management?schema=public&sslmode=disable
REDIS_URL=redis://redis:6379

# ── Frontend URLs (VPS) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://articvms.ddnsgeek.com
NEXT_PUBLIC_WS_URL=wss://articvms.ddnsgeek.com
CORS_ORIGIN=https://articvms.ddnsgeek.com

# =============================================================================
# OPTION B — Vercel (frontend) + Railway (backend) + Supabase (DB) + Upstash (Redis)
#   Set these as Environment Variables in each service's dashboard — NOT in a file.
# =============================================================================

# ── Supabase PostgreSQL (get from: supabase.com → Settings → Database → URI) ─
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── Upstash Redis (get from: upstash.com → your database → REST URL section) ─
# REDIS_URL=rediss://default:xxxxxxxxxxxx@xxx-xxxxx.upstash.io:6379

# ── Railway backend env vars ──────────────────────────────────────────────────
# Set all of these in the Railway project → Variables tab:
# DATABASE_URL=      (Supabase URI above)
# DIRECT_URL=        (Supabase direct URI above — needed for migrations)
# REDIS_URL=         (Upstash URI above)
# JWT_SECRET=        (openssl rand -hex 32)
# JWT_REFRESH_SECRET=(openssl rand -hex 32)
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
# PORT=4000
# NODE_ENV=production
# CORS_ORIGIN=https://your-project.vercel.app
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=byiringirofabrice6@gmail.com
# SMTP_PASS=advlaszqtqwbybwc
# SMTP_FROM=ARTIC VMS <byiringirofabrice6@gmail.com>

# ── Vercel frontend env vars ──────────────────────────────────────────────────
# Set in Vercel dashboard → Settings → Environment Variables:
# NEXT_PUBLIC_API_URL=https://artic-vms-backend.up.railway.app
# NEXT_PUBLIC_WS_URL=wss://artic-vms-backend.up.railway.app

# =============================================================================
# SHARED — same for both options
# =============================================================================

JWT_SECRET=change_me_min_32_chars_random_string_here
JWT_REFRESH_SECRET=change_refresh_secret_min_32_chars_here
# Generate with: openssl rand -hex 32

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=byiringirofabrice6@gmail.com
SMTP_PASS=advlaszqtqwbybwc
SMTP_FROM=ARTIC VMS <byiringirofabrice6@gmail.com>
