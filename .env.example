# ─── Copy this to .env in the project root on your server and fill in real values ──
# This file is read by docker-compose.
# NEVER commit the actual .env file — only this .env.example goes to git.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_this_to_a_strong_password

# ── JWT secrets ───────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
JWT_SECRET=change_me_min_32_chars_random_string_here
JWT_REFRESH_SECRET=change_refresh_secret_min_32_chars_here

# ── Frontend URLs ─────────────────────────────────────────────────────────────
# Production (domain + HTTPS):
NEXT_PUBLIC_API_URL=https://articvms.ddnsgeek.com
NEXT_PUBLIC_WS_URL=wss://articvms.ddnsgeek.com
#
# If you ever need to run without a domain (IP only, HTTP):
# NEXT_PUBLIC_API_URL=http://185.208.207.100
# NEXT_PUBLIC_WS_URL=ws://185.208.207.100
#
# NOTE: Do NOT append /api here. The frontend code adds /api/v1 itself.
# NOTE: These values are baked into the Next.js bundle at build time.
#       If you change them, rebuild the frontend container:
#       docker compose up -d --build frontend

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must exactly match the URL your browser uses to open the dashboard.
CORS_ORIGIN=https://articvms.ddnsgeek.com

# ── SMTP Email ────────────────────────────────────────────────────────────────
# Gmail: use an App Password (not your regular Gmail password).
# Create one at: https://myaccount.google.com/apppasswords
# Port 587 = STARTTLS. Port 465 = implicit TLS (set SMTP_SECURE=true).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password-here
SMTP_FROM="ARTIC VMS <your-gmail@gmail.com>"

# Public URL — used to build password-reset and notification links in emails
APP_URL=https://articvms.ddnsgeek.com
