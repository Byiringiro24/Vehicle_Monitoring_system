# ─── Production reference values for the Contabo server ─────────────────────
# Server: 185.208.207.100  |  Domain: articvms.ddnsgeek.com
# This file is for reference only. The actual secrets live in the project-root
# .env file on the server (never committed to git).
#
# When running with Docker Compose, the backend container receives its env vars
# from docker-compose.yml which reads from the root .env file — NOT this file.
# This file is only used if you ever run the backend directly (npm start)
# outside of Docker for debugging.

DATABASE_URL=postgresql://artic_user:YOUR_DB_PASSWORD@localhost:5432/fleet_management?schema=public&sslmode=disable
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_your_generated_secret
JWT_REFRESH_SECRET=replace_with_your_generated_secret

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=4000
MQTT_PORT=1883
NODE_ENV=production
CORS_ORIGIN=https://articvms.ddnsgeek.com
