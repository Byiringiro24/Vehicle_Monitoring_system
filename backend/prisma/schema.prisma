generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
//  ENUMS
// =============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FLEET_MANAGER
  DRIVER
  VIEWER
  FINANCE_MANAGER
  DISPATCHER
  HR_MANAGER
  MECHANIC
  COMPLIANCE_OFFICER
  RENTAL_MANAGER
}

// ─── Vehicle ──────────────────────────────────────────────────────────────────

enum VehicleStatus {
  AVAILABLE
  ACTIVE
  IDLE
  RENTED
  LEASED
  SOLD_INSTALLMENT
  RESERVED
  MAINTENANCE
  OUT_OF_SERVICE
  STOLEN
  RETIRED
  DECOMMISSIONED
  OFFLINE
}

enum VehicleClass {
  SEDAN
  SUV
  PICKUP
  VAN
  TRUCK
  BUS
  MINIBUS
  MOTORCYCLE
  BICYCLE
  TRAILER
  TRACTOR
  FORKLIFT
  HEAVY_EQUIPMENT
  OTHER
}

enum VehiclePurpose {
  TAXI
  DELIVERY
  COMPANY
  CONSTRUCTION
  AGRICULTURE
  LOGISTICS
  AMBULANCE
  GOVERNMENT
  RENTAL
  PERSONAL
  OTHER
}

enum EnergyType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  PHEV
  HYDROGEN
  LPG
  CNG
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  CVT
  SEMI_AUTO
}

enum OwnershipType {
  COMPANY_OWNED
  LEASED
  CUSTOMER_OWNED
  FINANCED
}

// ─── Driver ───────────────────────────────────────────────────────────────────

enum DriverStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ─── Contract / Finance ───────────────────────────────────────────────────────

enum ContractType {
  RENTAL_DAILY
  RENTAL_WEEKLY
  RENTAL_MONTHLY
  RENTAL_QUARTERLY
  RENTAL_YEARLY
  LEASE
  INSTALLMENT_SALE
  HIRE_PURCHASE
  DRIVER_DAILY_SUBMISSION
  DELIVERY
  CARGO
  PASSENGER
  TAXI
  CUSTOM
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  DEFAULTED
  TERMINATED
  SUSPENDED
  PENDING
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  WAIVED
  CANCELLED
}

enum ExpenseCategory {
  FUEL
  CHARGING
  MAINTENANCE
  INSURANCE
  ROAD_TAX
  INSPECTION
  PERMIT
  GPS_SIM
  TYRE
  BATTERY_REPLACE
  ACCIDENT_REPAIR
  PARKING
  FINE
  CLEANING
  TOWING
  DRIVER_SALARY
  LOAN_PAYMENT
  ACCESSORIES
  REPAIR
  OTHER
}

enum RequisitionType {
  EXPENSE_REIMBURSEMENT
  PURCHASE_ADVANCE
  DRIVER_ADVANCE
  PER_DIEM
  FUEL_ADVANCE
  PETTY_CASH
  SALARY_ADJUSTMENT
  DRIVER_DEDUCTION
  OWNER_PAYOUT
  SUPPLIER_PAYMENT
  REFUND
  SUBCONTRACTOR_PAY
  CUSTOM
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  SCHEDULED
  PAID
  RECONCILED
  ON_HOLD
  REJECTED
  CANCELLED
  VOID
}

// ─── Alerts ───────────────────────────────────────────────────────────────────

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum AlertType {
  SPEEDING
  GEOFENCE_ENTRY
  GEOFENCE_EXIT
  LOW_FUEL
  LOW_BATTERY
  ENGINE_OVERHEAT
  BATTERY_LOW_VOLTAGE
  HARSH_BRAKING
  HARSH_ACCELERATION
  ACCIDENT
  IDLE_TOO_LONG
  OFFLINE
  INSURANCE_EXPIRING
  ROAD_TAX_EXPIRING
  INSPECTION_DUE
  MAINTENANCE_DUE
  CUSTOM
}

// =============================================================================
//  CORE MODELS
// =============================================================================

model Organization {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  address     String?
  phone       String?
  email       String?
  country     String    @default("Rwanda")
  currency    String    @default("RWF")
  taxId       String?
  website     String?
  status      OrgStatus @default(ACTIVE)   // PENDING until Super Admin approves
  rejectionReason String?                  // set when status = REJECTED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users         User[]
  fleets        Fleet[]
  vehicles      Vehicle[]
  gpsDevices    GpsDevice[]
  drivers       Driver[]
  customers     Customer[]
  geofences     Geofence[]
  alertRules    AlertRule[]
  contracts     VehicleContract[]
  expenses      VehicleExpense[]
  cashFlows     CashFlow[]
  fuelRecords   FuelRecord[]
  memberships   Membership[]    @relation("OrgMemberships")
  subscription  Subscription?   @relation("OrgSubscription")
  entitlements  Entitlement[]   @relation("OrgEntitlements")
  documents     Document[]      @relation("OrgDocuments")
  businessModels BusinessModel[] @relation("OrgBusinessModels")
  agreements    Agreement[]     @relation("OrgAgreements")
  requisitions  Requisition[]   @relation("OrgRequisitions")

  @@map("organizations")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  middleName   String?
  role         UserRole    @default(VIEWER)
  roles        UserRole[]  @default([])
  pendingRoles UserRole[]  @default([])
  phone        String?
  altPhone     String?
  avatarUrl    String?
  nationalId   String?
  isActive     Boolean     @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  managedFleets          Fleet[]
  driverProfile          Driver?
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  acknowledgedAlerts      Alert[]         @relation("AcknowledgedBy")
  memberships            Membership[]    @relation("UserMemberships")
  sentInvitations        Membership[]    @relation("MembershipInviter")
  requisitionsRequested   Requisition[]  @relation("RequisitionRequester")
  requisitionsApproved    Requisition[]  @relation("RequisitionApprover")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ─── Fleet ───────────────────────────────────────────────────────────────────

model Fleet {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String   @default("#3B82F6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  managerId      String?
  manager        User?        @relation(fields: [managerId], references: [id])

  vehicles Vehicle[]

  @@map("fleets")
}

// ─── GPS Device ───────────────────────────────────────────────────────────────

model GpsDevice {
  id               String    @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  deviceId         String    @unique
  imei             String?   @unique
  simNumber        String?
  networkProvider  String?
  dataPlan         String?
  firmwareVersion  String?
  installationDate DateTime?
  removedDate      DateTime?
  technicianName   String?
  status           String    @default("ACTIVE")
  lastCommunication DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id])
  vehicleId String?   @unique

  @@map("gps_devices")
}

// ─── Vehicle ─────────────────────────────────────────────────────────────────

model Vehicle {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  fleetId         String?
  fleet           Fleet?         @relation(fields: [fleetId], references: [id])

  // Identity
  name            String
  licensePlate    String         @unique
  fleetNumber     String?
  assetTag        String?
  vin             String?        @unique
  engineNumber    String?
  registrationNumber String?

  // Classification
  vehicleClass    VehicleClass   @default(SEDAN)
  vehicleType     String         @default("CAR")
  purpose         VehiclePurpose @default(COMPANY)
  manufacturer    String
  model           String
  year            Int
  trim            String?
  color           String?

  // Status
  status          VehicleStatus  @default(OFFLINE)
  engineLocked    Boolean        @default(false)

  // Energy
  energyType      EnergyType     @default(PETROL)
  fuelCapacity    Float?
  recommendedFuel String?
  avgConsumption  Float?
  minFuelAlert    Float?
  fuelCardNumber  String?
  preferredStation String?
  batteryCapacityKwh  Float?
  batterySerial       String?
  batteryManufacturer String?
  batteryHealth       Float?
  batteryWarranty     DateTime?
  chargerType         String?
  chargingSpeedKw     Float?
  batteryReplaceCost  Float?

  // Engine
  engineType      String?
  engineCc        Float?
  horsepower      Int?
  transmission    TransmissionType @default(MANUAL)
  driveType       String?
  maxSpeedKph     Float?

  // GPS / Device Auth (deviceToken = MQTT password for this vehicle)
  deviceToken     String         @unique @default(uuid())
  simNumber       String?        // SIM card number installed in GPS device

  // Data plan tracking for the GPS SIM card
  dataPlanType      String?   // "DAILY" | "WEEKLY" | "MONTHLY"
  dataPlanExpiry    DateTime? // when the current data plan expires
  dataPlanBoughtAt  DateTime? // when it was purchased
  dataPlanAlertSent Boolean   @default(false)

  // Ownership
  ownerName       String?
  ownerCompany    String?
  ownershipType   OwnershipType  @default(COMPANY_OWNED)
  purchaseDate    DateTime?
  purchasePrice   Float?
  currentValue    Float?
  supplierName    String?
  warrantyExpiry  DateTime?

  // Insurance
  insuranceCompany    String?
  insurancePolicyNo   String?
  insuranceStart      DateTime?
  insuranceExpiry     DateTime?
  insurancePremium    Float?
  insuranceCoverage   String?
  insuranceAgent      String?
  insuranceEmergency  String?

  // Government compliance
  roadTaxExpiry       DateTime?
  inspectionExpiry    DateTime?
  transportPermit     String?
  transportPermitExpiry DateTime?
  commercialLicense   String?
  commercialLicExpiry DateTime?
  taxiPermit          String?
  taxiPermitExpiry    DateTime?
  roadworthinessCert  String?
  emissionCert        String?
  emissionExpiry      DateTime?

  // Maintenance schedule
  oilChangeKmInterval    Float?
  nextServiceDate        DateTime?
  lastServiceDate        DateTime?
  lastServiceOdometer    Float?

  // Tyre info
  tyreBrand        String?
  tyreSize         String?
  tyreFrontLeft    String?
  tyreFrontRight   String?
  tyreRearLeft     String?
  tyreRearRight    String?
  tyreSpare        String?
  tyrePurchaseDate DateTime?

  // Documents (file URLs)
  docRegistrationCard  String?
  docInsurancePdf      String?
  docInspectionCert    String?
  docPurchaseInvoice   String?
  docPhoto             String?
  docOwnershipCert     String?

  // Owner (for personal owner portal — independent of org ownership)
  ownerUserId     String?        // links to User who privately owns this vehicle

  odometer        Float          @default(0)
  engineHours     Float          @default(0)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  gpsDevice       GpsDevice?
  currentDriver   Driver?        @relation("CurrentVehicle")
  driverAssignments DriverAssignment[]
  telemetry       Telemetry[]
  lastLocation    LastLocation?
  alerts          Alert[]
  geofenceEvents  GeofenceEvent[]
  trips           Trip[]
  fuelRecords     FuelRecord[]
  expenses        VehicleExpense[]
  contracts       VehicleContract[]
  maintenance     MaintenanceRecord[]
  vehicleAgreements Agreement[]  @relation("VehicleAgreements")

  @@map("vehicles")
}

// ─── Driver ───────────────────────────────────────────────────────────────────

model Driver {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id])

  // Employment
  employeeNumber  String?
  department      String?
  position        String?
  employmentDate  DateTime?
  status          DriverStatus @default(ACTIVE)
  baseSalary      Float?
  commissionRate  Float?

  // Personal
  gender          Gender?
  dateOfBirth     DateTime?
  nationality     String?
  nationalId      String?       @unique
  passportNumber  String?
  photoUrl        String?
  address         String?
  city            String?
  district        String?
  altPhone        String?
  emergencyContact String?
  emergencyPhone  String?

  // License
  licenseNumber   String        @unique
  licenseClass    String?
  licenseIssueDate DateTime?
  licenseExpiry   DateTime?
  licenseCountry  String?
  licenseRestrictions String?
  licensePhotoUrl String?

  // Experience
  yearsDriving    Int?
  taxiExperience  Boolean @default(false)
  truckExperience Boolean @default(false)
  motoExperience  Boolean @default(false)
  busExperience   Boolean @default(false)
  specialSkills   String?

  // Health
  bloodGroup      String?
  medicalCertUrl  String?
  medicalExpiry   DateTime?
  visionTest      Boolean @default(false)
  medicalNotes    String?

  // Banking
  bankName        String?
  bankAccount     String?
  mobileMoney     String?
  taxId           String?

  // Documents
  docLicenseUrl    String?
  docNationalIdUrl String?
  docPassportUrl   String?
  docPoliceUrl     String?
  docMedicalUrl    String?
  docContractUrl   String?

  joiningDate     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Current vehicle assignment (for quick lookup)
  currentVehicleId String?   @unique
  currentVehicle   Vehicle?  @relation("CurrentVehicle", fields: [currentVehicleId], references: [id])

  assignments     DriverAssignment[]
  payments        DriverPayment[]
  contracts       VehicleContract[]
  fuelRecords     FuelRecord[]
  expenses        VehicleExpense[]

  @@map("drivers")
}

model DriverAssignment {
  id          String   @id @default(uuid())
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id])
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  startDate   DateTime
  endDate     DateTime?
  purpose     String?
  department  String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([driverId])
  @@index([vehicleId])
  @@map("driver_assignments")
}

// ─── Customer ─────────────────────────────────────────────────────────────────

model Customer {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  name            String
  photoUrl        String?
  nationalId      String?
  passportNumber  String?
  phone           String
  altPhone        String?
  email           String?
  address         String?
  city            String?
  district        String?
  occupation      String?
  employer        String?
  emergencyContact String?
  emergencyPhone  String?
  guarantorName   String?
  guarantorPhone  String?
  creditScore     Int          @default(100)
  creditStatus    String       @default("GOOD")
  notes           String?

  // Documents
  docNationalIdUrl String?
  docPassportUrl   String?
  docPhotoUrl      String?
  docOtherUrl      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contracts       VehicleContract[]
  payments        ContractPayment[]
  customerAgreements Agreement[] @relation("CustomerAgreements")

  @@map("customers")
}

// =============================================================================
//  CONTRACTS & PAYMENTS
// =============================================================================

model VehicleContract {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  vehicleId       String
  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id])
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  driverId        String?
  driver          Driver?        @relation(fields: [driverId], references: [id])

  contractNumber  String         @unique @default(uuid())
  contractType    ContractType
  status          ContractStatus @default(ACTIVE)

  startDate       DateTime
  endDate         DateTime?
  expectedEndDate DateTime?

  totalValue      Float
  depositAmount   Float          @default(0)
  depositPaid     Float          @default(0)
  periodicAmount  Float
  periodDays      Int?
  customSchedule  String?

  dailyRate       Float?
  weeklyRate      Float?
  monthlyRate     Float?

  sellingPrice    Float?
  installmentAmount Float?
  installmentCount  Int?
  ownershipTransferDate DateTime?

  totalPaid       Float          @default(0)
  totalBalance    Float          @default(0)
  lateFees        Float          @default(0)
  overdueAmount   Float          @default(0)

  notes           String?
  contractFileUrl String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  payments        ContractPayment[]

  @@index([organizationId, status])
  @@index([vehicleId])
  @@index([customerId])
  @@map("vehicle_contracts")
}

model ContractPayment {
  id          String          @id @default(uuid())
  contractId  String
  contract    VehicleContract @relation(fields: [contractId], references: [id])
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])

  amount      Float
  currency    String          @default("RWF")
  dueDate     DateTime
  paidDate    DateTime?
  status      PaymentStatus   @default(PENDING)
  method      String?
  reference   String?
  lateFee     Float           @default(0)
  notes       String?
  receiptUrl  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([contractId, dueDate])
  @@index([status])
  @@map("contract_payments")
}

// ─── Driver Payments ─────────────────────────────────────────────────────────

model DriverPayment {
  id             String        @id @default(uuid())
  driverId       String
  driver         Driver        @relation(fields: [driverId], references: [id])
  date           DateTime      @default(now())
  month          Int
  year           Int
  expectedAmount Float         @default(0)
  paidAmount     Float         @default(0)
  difference     Float         @default(0)
  baseSalary     Float         @default(0)
  commission     Float         @default(0)
  bonus          Float         @default(0)
  deductions     Float         @default(0)
  totalAmount    Float         @default(0)
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([driverId, month, year])
  @@map("driver_payments")
}

model Requisition {
  id                 String            @id @default(uuid())
  organizationId     String
  organization       Organization       @relation("OrgRequisitions", fields: [organizationId], references: [id], onDelete: Cascade)
  requesterId        String
  requester          User              @relation("RequisitionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  type               RequisitionType
  status             RequisitionStatus @default(SUBMITTED)
  amount             Float
  neededBy           DateTime?
  reason             String
  paymentPreference  String?
  vehicleId          String?
  tripReference      String?
  workOrderRef       String?
  agreementRef       String?
  notes              String?
  rejectedReason     String?
  approvedById       String?
  approvedBy         User?             @relation("RequisitionApprover", fields: [approvedById], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([organizationId, status])
  @@index([requesterId])
  @@map("requisitions")
}

// =============================================================================
//  FUEL & ENERGY
// =============================================================================

model FuelRecord {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId        String?
  driver          Driver?  @relation(fields: [driverId], references: [id])

  date            DateTime @default(now())
  energyType      EnergyType
  fuelStation     String?
  stationCity     String?

  // Petrol/Diesel
  litres          Float?
  pricePerLitre   Float?

  // Electric
  isHomeCharging  Boolean  @default(false)
  startBatteryPct Float?
  endBatteryPct   Float?
  kwhAdded        Float?
  pricePerKwh     Float?
  chargingMinutes Int?

  totalCost       Float
  mileageAtFuel   Float?
  receiptUrl      String?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([vehicleId, date(sort: Desc)])
  @@map("fuel_records")
}

// =============================================================================
//  MAINTENANCE
// =============================================================================

model MaintenanceRecord {
  id              String   @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])

  date            DateTime @default(now())
  maintenanceType String
  description     String
  garage          String?
  garageAddress   String?
  mechanicName    String?
  invoiceNumber   String?
  cost            Float
  currency        String   @default("RWF")
  mileageAtService Float?
  nextServiceDate DateTime?
  nextServiceOdometer Float?
  receiptUrl      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([vehicleId, date(sort: Desc)])
  @@map("maintenance_records")
}

// =============================================================================
//  EXPENSES
// =============================================================================

model VehicleExpense {
  id              String          @id @default(uuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])
  vehicleId       String
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  driverId        String?
  driver          Driver?         @relation(fields: [driverId], references: [id])

  category        ExpenseCategory
  amount          Float
  currency        String          @default("RWF")
  date            DateTime        @default(now())
  description     String
  supplier        String?
  invoiceNumber   String?
  receiptUrl      String?

  // Fuel (if using expense for fuel)
  fuelStation     String?
  litres          Float?
  pricePerLitre   Float?
  fuelTypePumped  String?
  mileageAtFuel   Float?

  // Maintenance
  maintenanceType String?
  mechanicName    String?
  garageAddress   String?
  mileageAtService Float?

  // Insurance
  insuranceCompany String?
  policyNumber     String?
  policyStartDate  DateTime?
  policyEndDate    DateTime?
  coverType        String?

  // Fine
  fineNumber      String?
  fineReason      String?
  fineLocation    String?
  officerName     String?
  fineDate        DateTime?

  // Tyre
  tyrePosition    String?
  tyreSerial      String?
  tyreBrand       String?

  // GPS/SIM
  simNumber       String?
  gpsDeviceId     String?

  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, date(sort: Desc)])
  @@index([vehicleId, category])
  @@map("vehicle_expenses")
}

// =============================================================================
//  GPS TRACKING
// =============================================================================

model Telemetry {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  timestamp   DateTime @default(now())

  latitude    Float?
  longitude   Float?
  altitude    Float?
  heading     Float?
  accuracy    Float?
  speed       Float?      // km/h
  odometer    Float?      // km
  engineTemp  Float?      // celsius
  rpm         Int?
  engineOn    Boolean  @default(false)
  fuelLevel   Float?      // percentage
  fuelUsed    Float?
  batteryVoltage   Float?
  batteryLevelPct  Float?
  ignition         Boolean @default(false)
  rawData          Json?

  @@index([vehicleId, timestamp(sort: Desc)])
  @@map("telemetry")
}

model LastLocation {
  id              String   @id @default(uuid())
  vehicleId       String   @unique
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])

  latitude        Float
  longitude       Float
  speed           Float    @default(0)
  heading         Float    @default(0)
  fuelLevel       Float?
  batteryLevelPct Float?
  engineTemp      Float?
  engineOn        Boolean  @default(false)
  address         String?
  distanceTodayKm Float    @default(0)
  distanceMonthKm Float    @default(0)
  totalDistanceKm Float    @default(0)
  updatedAt       DateTime @updatedAt

  @@map("last_locations")
}

model Trip {
  id           String   @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId     String?

  startTime    DateTime
  endTime      DateTime?
  startLat     Float?
  startLon     Float?
  endLat       Float?
  endLon       Float?
  startAddress String?
  endAddress   String?
  distanceKm   Float    @default(0)
  maxSpeedKph  Float    @default(0)
  avgSpeedKph  Float    @default(0)
  engineHours  Float    @default(0)
  idleMinutes  Float    @default(0)
  fuelUsed     Float?
  // Store the GPS path as array of {lat,lng,ts} for replay
  pathPoints   Json?

  createdAt    DateTime @default(now())

  @@index([vehicleId, startTime(sort: Desc)])
  @@map("trips")
}

// GPS history points stored separately for high-resolution replay
model GpsHistory {
  id        String   @id @default(uuid())
  vehicleId String
  tripId    String?
  timestamp DateTime @default(now())
  latitude  Float
  longitude Float
  speed     Float    @default(0)
  heading   Float    @default(0)
  accuracy  Float?

  @@index([vehicleId, timestamp(sort: Desc)])
  @@index([tripId])
  @@map("gps_history")
}

// =============================================================================
//  ALERTS & GEOFENCES
// =============================================================================

model Alert {
  id        String        @id @default(uuid())
  vehicleId String
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id])
  type      AlertType
  severity  AlertSeverity
  status    AlertStatus   @default(ACTIVE)
  title     String
  message   String
  metadata  Json?

  triggeredAt      DateTime  @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?     @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id])
  resolvedAt       DateTime?

  @@index([vehicleId, triggeredAt(sort: Desc)])
  @@index([status])
  @@map("alerts")
}

model AlertRule {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  type           AlertType
  severity       AlertSeverity @default(MEDIUM)
  isActive       Boolean       @default(true)
  conditions     Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("alert_rules")
}

model Geofence {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  color          String       @default("#EF4444")
  coordinates    Json
  type           String       @default("polygon")
  alertOnEntry   Boolean      @default(true)
  alertOnExit    Boolean      @default(true)
  isActive       Boolean      @default(true)
  // Store array of vehicleIds this geofence applies to (empty = all vehicles)
  vehicleIds     String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  events GeofenceEvent[]

  @@map("geofences")
}

model GeofenceEvent {
  id         String   @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  geofenceId String
  geofence   Geofence @relation(fields: [geofenceId], references: [id])
  eventType  String
  timestamp  DateTime @default(now())

  @@map("geofence_events")
}

// =============================================================================
//  CASH FLOW
// =============================================================================

model CashFlow {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  date           DateTime @default(now())
  description    String
  amount         Float
  type           String   // INCOME | EXPENSE
  category       String
  method         String   @default("CASH")
  reference      String?
  balance        Float    @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, date(sort: Desc)])
  @@map("cash_flows")
}

// ─── Password Reset Tokens ────────────────────────────────────────────────────
// Stores a SHA-256 hash of the token — the raw token is only ever in the email.
// Single-use: deleted immediately on successful reset.
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique             // SHA-256 of the raw token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// =============================================================================
//  BUILD 1 — UNIFIED IDENTITY: MEMBERSHIPS, PLANS, SUBSCRIPTIONS, ENTITLEMENTS
//  Added additively — zero breaking changes to existing tables.
// =============================================================================

// ─── Membership status ────────────────────────────────────────────────────────
enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ENDED
}

// ─── Membership role (company-scoped, separate from legacy UserRole) ──────────
enum MembershipRole {
  COMPANY_OWNER
  COMPANY_ADMIN
  FLEET_MANAGER
  DISPATCHER
  FINANCE_MANAGER
  ACCOUNTANT
  HR_MANAGER
  MECHANIC
  DRIVER
  SAFETY_OFFICER
  AUDITOR
  CUSTOMER
  SUPPLIER
  VIEWER
}

// ─── Subscription plan tier ───────────────────────────────────────────────────
enum PlanTier {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
  CUSTOM
}

// ─── Subscription status ──────────────────────────────────────────────────────
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

// ─── Entitlement (feature access) status ────────────────────────────────────
enum EntitlementStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

// =============================================================================
//  MEMBERSHIP — one User may belong to multiple Organizations
// =============================================================================
// This coexists with the legacy User.organizationId field.
// New code should use Membership; legacy code still works via organizationId.

model Membership {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation("OrgMemberships", fields: [organizationId], references: [id], onDelete: Cascade)
  role           MembershipRole   @default(VIEWER)
  status         MembershipStatus @default(INVITED)

  // Invite tracking
  invitedById    String?
  invitedBy      User?            @relation("MembershipInviter", fields: [invitedById], references: [id])
  invitedAt      DateTime         @default(now())
  acceptedAt     DateTime?
  endedAt        DateTime?
  suspendedAt    DateTime?
  suspendReason  String?
  notes          String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

// =============================================================================
//  SUBSCRIPTION PLAN — platform-level plan catalogue (Super Admin manages)
// =============================================================================

model Plan {
  id               String    @id @default(uuid())
  name             String    @unique
  slug             String    @unique
  tier             PlanTier  @default(STARTER)
  description      String?
  monthlyPriceUsd  Float     @default(0)
  annualPriceUsd   Float     @default(0)
  includedSeats    Int       @default(5)
  extraSeatPriceUsd Float    @default(0)
  isPublic         Boolean   @default(true)
  isActive         Boolean   @default(true)
  trialDays        Int       @default(14)
  features         Json      @default("[]")   // array of feature keys included
  limits           Json      @default("{}")   // e.g. { maxVehicles: 50, maxApiCalls: 1000 }
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subscriptions    Subscription[]

  @@map("plans")
}

// =============================================================================
//  SUBSCRIPTION — one Organization subscribes to one Plan at a time
// =============================================================================

model Subscription {
  id               String             @id @default(uuid())
  organizationId   String             @unique  // one active subscription per org
  organization     Organization       @relation("OrgSubscription", fields: [organizationId], references: [id])
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(TRIAL)
  seats            Int                @default(5)    // purchased seats
  seatsUsed        Int                @default(0)   // tracked count

  trialEndsAt      DateTime?
  currentPeriodStart DateTime         @default(now())
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  notes            String?            // Super Admin notes

  // Billing reference (for future payment provider integration)
  externalRef      String?
  currency         String             @default("USD")
  billingInterval  String             @default("monthly") // monthly | annual

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  entitlements     Entitlement[]

  @@map("subscriptions")
}

// =============================================================================
//  ENTITLEMENT — specific feature enabled for an organization
// =============================================================================
// Super Admin grants/revokes features independently of the plan.
// This allows per-company overrides and add-ons.

model Entitlement {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation("OrgEntitlements", fields: [organizationId], references: [id])
  subscriptionId   String?
  subscription     Subscription?     @relation(fields: [subscriptionId], references: [id])

  featureKey       String            // e.g. "fleet.gps", "finance.accounting", "ai.assistant"
  status           EntitlementStatus @default(ACTIVE)
  grantedById      String?           // Super Admin who granted it
  expiresAt        DateTime?
  usageLimit       Int?              // null = unlimited
  usageCount       Int               @default(0)
  metadata         Json?             // extra config e.g. { maxVehicles: 100 }

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, featureKey])
  @@index([organizationId])
  @@map("entitlements")
}

// =============================================================================
//  AUDIT LOG — platform-level sensitive event tracking
// =============================================================================

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String   // e.g. "membership.invite", "subscription.activate", "entitlement.grant"
  targetType     String?  // e.g. "User", "Organization", "Subscription"
  targetId       String?
  before         Json?    // previous value
  after          Json?    // new value
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
//  BUILD 2 — DOCUMENT MANAGEMENT
// =============================================================================

enum DocumentOwnerType {
  VEHICLE
  DRIVER
  USER
  ORGANIZATION
  CUSTOMER
  SUPPLIER
}

enum DocumentStatus {
  PENDING_UPLOAD    // slot created but file not yet uploaded
  PENDING_REVIEW    // uploaded, awaiting verification
  VERIFIED          // reviewed and accepted
  REJECTED          // reviewed and rejected
  EXPIRED           // passed expiry date
  SUPERSEDED        // replaced by a newer version
}

enum DocumentCategory {
  REGISTRATION_CARD
  INSURANCE
  INSPECTION_CERTIFICATE
  ROAD_TAX
  TRANSPORT_PERMIT
  COMMERCIAL_LICENSE
  TAXI_PERMIT
  ROADWORTHINESS
  EMISSION_CERTIFICATE
  PURCHASE_INVOICE
  OWNERSHIP_CERTIFICATE
  DRIVING_LICENSE
  NATIONAL_ID
  PASSPORT
  MEDICAL_CERTIFICATE
  POLICE_CLEARANCE
  EMPLOYMENT_CONTRACT
  PHOTO
  YELLOW_CARD
  OTHER
}

model Document {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation("OrgDocuments", fields: [organizationId], references: [id], onDelete: Cascade)

  // Polymorphic owner — what this document belongs to
  ownerType      DocumentOwnerType
  ownerId        String              // vehicleId, driverId, userId, etc.

  // Classification
  category       DocumentCategory    @default(OTHER)
  label          String              // human-readable e.g. "Insurance Certificate 2026"

  // File storage
  fileUrl        String?             // path/URL to the stored file
  fileName       String?
  fileMimeType   String?
  fileSizeBytes  Int?
  fileHash       String?             // SHA-256 of the file content

  // Document metadata
  documentNumber String?             // policy number, ID number, etc.
  issuer         String?             // issuing authority / company
  issuedAt       DateTime?
  expiresAt      DateTime?           // null = does not expire

  // Review workflow
  status         DocumentStatus      @default(PENDING_UPLOAD)
  reviewedById   String?
  reviewedAt     DateTime?
  rejectionReason String?
  notes          String?

  // Version tracking
  version        Int                 @default(1)
  supersededById String?             // points to the newer document that replaced this

  // Reminder tracking
  reminderSent30d Boolean            @default(false)
  reminderSent7d  Boolean            @default(false)
  reminderSentExpired Boolean        @default(false)

  uploadedById   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([ownerType, ownerId])
  @@index([expiresAt])
  @@index([status])
  @@map("documents")
}

// =============================================================================
//  BUILD 3 — VEHICLE BUSINESS MODEL BUILDER
//  Configurable agreement types, pricing rules, payment schedules.
// =============================================================================

enum BusinessModelType {
  DAILY_RENTAL
  WEEKLY_RENTAL
  MONTHLY_RENTAL
  ANNUAL_RENTAL
  LEASE_TO_OWN       // hire-purchase / installment sale
  VEHICLE_SALE
  DRIVER_SERVICE
  TRANSPORT_CONTRACT
  FLEET_MANAGEMENT   // manage vehicle for owner, collect fees
  CUSTOM
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  COMPLETED
  DEFAULTED
  TERMINATED
  SUSPENDED
  PENDING_SIGNATURE
}

enum ScheduledPaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  WAIVED
  CANCELLED
}

// ─── BusinessModel — company-configurable template ───────────────────────────
// Super Admin sets defaults; Company Admin can create their own within limits.
model BusinessModel {
  id             String             @id @default(uuid())
  organizationId String?            // null = platform default (Super Admin)
  organization   Organization?      @relation("OrgBusinessModels", fields: [organizationId], references: [id], onDelete: Cascade)

  modelType      BusinessModelType  @default(CUSTOM)
  name           String
  description    String?
  isActive       Boolean            @default(true)
  isPublic       Boolean            @default(false)  // visible in marketplace

  // Default pricing rule (overridable per agreement)
  currency       String             @default("RWF")
  rateAmount     Float              @default(0)
  ratePeriod     String             @default("daily") // hourly|daily|weekly|monthly|per_trip|custom
  depositAmount  Float              @default(0)

  // Responsibilities
  maintenancePaidBy  String         @default("company")  // company|customer|shared
  fuelPaidBy         String         @default("customer")
  insurancePaidBy    String         @default("company")

  // Late payment
  gracePeriodDays  Int              @default(3)
  lateFeeAmount    Float            @default(0)
  lateFeePercent   Float            @default(0)  // % of overdue amount

  // Ownership transfer (for lease-to-own)
  transferCondition String?        // description of when ownership transfers

  metadata       Json?

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  agreements     Agreement[]

  @@index([organizationId])
  @@map("business_models")
}

// ─── Agreement — one signed arrangement between company and customer ──────────
model Agreement {
  id               String          @id @default(uuid())
  organizationId   String
  organization     Organization    @relation("OrgAgreements", fields: [organizationId], references: [id], onDelete: Cascade)

  businessModelId  String?
  businessModel    BusinessModel?  @relation(fields: [businessModelId], references: [id])

  vehicleId        String
  vehicle          Vehicle         @relation("VehicleAgreements", fields: [vehicleId], references: [id])

  customerId       String
  customer         Customer        @relation("CustomerAgreements", fields: [customerId], references: [id])

  driverId         String?         // optional — driver assigned under this agreement

  // Agreement identity
  agreementNumber  String          @unique @default(uuid())
  title            String
  modelType        BusinessModelType @default(CUSTOM)
  status           AgreementStatus @default(DRAFT)

  // Financial terms (snapshot at signing — not changed by later BusinessModel edits)
  currency         String          @default("RWF")
  rateAmount       Float
  ratePeriod       String          @default("daily")
  depositAmount    Float           @default(0)
  depositPaid      Float           @default(0)
  totalValue       Float?          // for fixed-value agreements (lease-to-own, sale)
  installmentCount Int?            // for hire-purchase

  // Dates
  startDate        DateTime
  endDate          DateTime?
  expectedEndDate  DateTime?

  // Running totals (calculated from payments, not editable)
  totalPaid        Float           @default(0)
  totalBalance     Float           @default(0)
  overdueAmount    Float           @default(0)

  // Signed contract
  contractFileUrl  String?
  signedAt         DateTime?
  notes            String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  scheduledPayments ScheduledPayment[]
  paymentRecords    PaymentRecord[]

  @@index([organizationId])
  @@index([vehicleId])
  @@index([customerId])
  @@index([status])
  @@map("agreements")
}

// ─── ScheduledPayment — one payment obligation in a payment schedule ──────────
// Generated automatically when an agreement is activated.
// Balances derive from records — never edited directly.
model ScheduledPayment {
  id           String                  @id @default(uuid())
  agreementId  String
  agreement    Agreement               @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  periodLabel  String                  // e.g. "Day 1", "Week 3", "Installment 5"
  dueDate      DateTime
  amountDue    Float
  currency     String                  @default("RWF")
  status       ScheduledPaymentStatus  @default(PENDING)

  amountPaid   Float                   @default(0)
  paidAt       DateTime?
  lateFee      Float                   @default(0)
  notes        String?
  reminderSent Boolean                 @default(false)

  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  paymentRecords PaymentRecord[]

  @@index([agreementId])
  @@index([dueDate])
  @@index([status])
  @@map("scheduled_payments")
}

// ─── PaymentRecord — one actual payment received ─────────────────────────────
model PaymentRecord {
  id                  String   @id @default(uuid())
  organizationId      String
  agreementId         String
  agreement           Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  scheduledPaymentId  String?
  scheduledPayment    ScheduledPayment? @relation(fields: [scheduledPaymentId], references: [id])

  amount              Float
  currency            String   @default("RWF")
  paidAt              DateTime @default(now())
  method              String   @default("CASH")  // CASH|MOBILE_MONEY|BANK|CARD|OTHER
  reference           String?  // mobile money tx, bank ref, receipt #
  notes               String?
  recordedById        String?  // user who recorded this payment

  createdAt           DateTime @default(now())

  @@index([agreementId])
  @@index([organizationId])
  @@map("payment_records")
}

// =============================================================================
//  REGISTRATION APPROVAL, SUPPORT CONTACTS & TICKETS
// =============================================================================

enum OrgStatus {
  PENDING    // just registered, awaiting Super Admin approval
  ACTIVE     // approved and fully operational
  REJECTED   // rejected by Super Admin
  SUSPENDED  // was active, now suspended
}

// ─── Support Contact — configured by Super Admin, visible to all ──────────────
model SupportContact {
  id        String   @id @default(uuid())
  platform  String   // e.g. "WhatsApp", "Email", "Phone", "Instagram", "TikTok"
  value     String   // e.g. "+250787585826", "byiringirofabrice6@gmail.com"
  label     String?  // optional display label e.g. "Call or WhatsApp"
  icon      String?  // icon name hint for frontend e.g. "whatsapp", "mail"
  url       String?  // optional link e.g. "https://wa.me/250787585826"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("support_contacts")
}

// ─── Support Ticket — submitted by any user, reviewed by Super Admin ─────────
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id             String         @id @default(uuid())
  organizationId String?        // null = from a pending/unattached user
  userId         String?        // who submitted it
  userEmail      String         // always stored so we can reply
  userName       String
  subject        String
  message        String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  category       String         @default("general") // general | billing | technical | feature
  adminNotes     String?        // internal notes by Super Admin
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([status])
  @@map("support_tickets")
}
